<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<!-- Lets the wallet update its own package (packaging/deb/update) after asking for an administrator
     password, with a message that says what it is for. Installed by the .deb in
     /usr/share/polkit-1/actions/. -->
<policyconfig>
  <vendor>Atesta ID Wallet</vendor>
  <vendor_url>https://github.com/CitComAI-Hub/atesta-id-wallet</vendor_url>
  <icon_name>atesta-id-wallet</icon_name>
  <action id="io.github.citcomaihub.atestaidwallet.update">
    <description>Update Atesta ID Wallet</description>
    <description xml:lang="es">Actualizar Atesta ID Wallet</description>
    <description xml:lang="da">Opdater Atesta ID Wallet</description>
    <description xml:lang="de">Atesta ID Wallet aktualisieren</description>
    <description xml:lang="fr">Mettre à jour Atesta ID Wallet</description>
    <description xml:lang="lb">Atesta ID Wallet aktualiséieren</description>
    <message>Authentication is required to update Atesta ID Wallet</message>
    <message xml:lang="es">Se necesita autenticación para actualizar Atesta ID Wallet</message>
    <message xml:lang="da">Godkendelse er påkrævet for at opdatere Atesta ID Wallet</message>
    <message xml:lang="de">Zum Aktualisieren von Atesta ID Wallet ist eine Authentifizierung erforderlich</message>
    <message xml:lang="fr">Une authentification est nécessaire pour mettre à jour Atesta ID Wallet</message>
    <message xml:lang="lb">Fir Atesta ID Wallet ze aktualiséieren ass eng Authentifizéierung néideg</message>
    <defaults>
      <allow_any>auth_admin</allow_any>
      <allow_inactive>auth_admin</allow_inactive>
      <allow_active>auth_admin_keep</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/libexec/atesta-id-wallet/update</annotate>
  </action>
</policyconfig>
